TENSORSTEAD_MCP_TRANSPORT=streamable-http
TENSORSTEAD_MCP_BIND_HOST={{ tensorstead_mcp_bind_host | default('0.0.0.0') }}
TENSORSTEAD_MCP_PORT={{ tensorstead_mcp_port | default(8090) }}
TENSORSTEAD_MCP_PATH={{ tensorstead_mcp_path | default('/mcp') }}
TENSORSTEAD_MCP_TLS_CERT={{ tensorstead_agent_tls_cert }}
TENSORSTEAD_MCP_TLS_KEY={{ tensorstead_agent_tls_key }}
{# The coordinator presents its certificate on loopback too, so this hop is
   verified like any other rather than trusted for being local. #}
{# Addressed by the certificate's SAN, not by 127.0.0.1: hostname verification
   compares against the SAN, and an IP literal would not match it. #}
TENSORSTEAD_API={{ 'https://' + tensorstead_agent_tls_server_name if tensorstead_managed_tls | bool else 'http://127.0.0.1' }}:{{ tensorstead_coordinator_port }}
TENSORSTEAD_CA_BUNDLE={{ tensorstead_agent_ca_bundle }}
TENSORSTEAD_MGMT_TOKEN={{ tensorstead_management_token }}
