TENSORSTEAD_MGMT_TOKEN={{ tensorstead_management_token }}
TENSORSTEAD_REPLICATION_TOKEN={{ tensorstead_replication_token }}
TENSORSTEAD_MODEL_STORE_PATH={{ tensorstead_agent_model_store }}
TENSORSTEAD_IMAGE_STORE_PATH={{ tensorstead_agent_image_store }}
TENSORSTEAD_STATE_DIR={{ tensorstead_agent_state_dir }}
TENSORSTEAD_CACHE_PATH={{ tensorstead_agent_cache_path | default('/var/lib/tensorstead/cache') }}
TENSORSTEAD_INFERENCE_API_KEY={{ hostvars['localhost'].tensorstead_inference_api_key }}
# Whether this node may arrange for deployments to restart on boot. Default
# false, and deliberately settable only from here.
#
# A deployment field can be set by anything holding a management token. This
# file is written by `make deploy`, which prompts for the Vault and become
# passwords -- so granting the capability needs credentials that have not been
# given to any agent, while exercising it needs only the deployment flag. An
# agent can do the second and never the first.
#
# The authority being gated is real: an unconditional boot-restoration
# arrangement turned an NVIDIA driver deadlock into a node that came back into
# the same deadlock on every reboot, and then into a reimage. Turn this on for a
# node once you are willing for it to start inference workloads before anyone
# can log in.
TENSORSTEAD_ALLOW_BOOT_RESTORATION={{ 'true' if (tensorstead_allow_boot_restoration | default(false) | bool) else 'false' }}
{% if tensorstead_managed_tls | bool %}
# The trust anchor for *agent-to-agent* TLS. site.yml already installs this
# bundle on every agent, and nothing pointed at it: ImageDistributionService
# read TENSORSTEAD_AGENT_CA_BUNDLE and, finding it unset, fell back to the public
# trust store -- which cannot contain a private managed CA. So the coordinator's
# management calls verified and the peer image transfer did not, which is why
# the first live multi-node build failed with CERTIFICATE_VERIFY_FAILED while
# every other hop looked healthy.
#
# Set only under managed TLS, because that is the only profile in which this
# file is installed; naming a path that does not exist would trade a clear
# verification failure for a confusing one.
TENSORSTEAD_AGENT_CA_BUNDLE={{ tensorstead_agent_ca_bundle }}
{% endif %}
